# MongoDB（1Panel 应用商店安装，仅监听 127.0.0.1，开启认证，库 mooo + 专用用户）
# 容器内访问宿主机 127.0.0.1 需 network_mode: host 或 host.docker.internal
MONGO_URL=mongodb://mooo:CHANGE_ME@127.0.0.1:27017/mooo?authSource=mooo
MONGO_DB=mooo
RAW_RETENTION_DAYS=14
CRAWL_INTERVAL_MIN=30
ENABLE_SCHEDULER=1
PROXY_POOL_URL=
PROXY_LIST=
BROWSER_CDP_URL=
# 管线（每 2 小时一轮）
PROXY_REQUIRED=1             # 生产必须为 1：代理池不可用则整轮停止，不直连
CRAWL_EVERY_HOURS=24
TARGET_WORKERS=4             # 全局并发上限（同域名始终串行）
DOMAIN_DELAY=2.0             # 同域名请求间隔（秒）
TARGET_CRAWL_MAX=120         # 每轮最多定向抓取目标数
TARGET_MIN_INTERVAL_H=6      # 同一目标最小抓取间隔
MAX_PAGES_PER_TARGET=5
TG_DB_PATH=/tg/messages.db
TG_PREVIEW_MAX=40
GITHUB_LIST_URLS=https://raw.githubusercontent.com/LiLittleCat/awesome-free-chatgpt/main/README.md
BRAVE_API_KEY=               # 搜索引擎指纹发现（可选）
CAPTCHA_RETRY_H=168          # blocked_captcha 目标冷处理时长（小时，默认 7 天）
# ---- 链动小铺（ldxp）出口 ----
# 实测结论（2026-10-13）：ldxp 全站套阿里云 ESA 的 AliyunCaptcha JS 挑战，判定维度是「IP 归属地」：
#   中国浙江住宅宽带 ✅ / 中国上海机房(阿里云) ✅ / 日本东京机房 ❌ / 美国洛杉矶机房 ❌ / 西班牙代理 ❌
# 中国机房 IP 能过、外国 IP 全过不去 —— 所以不是「机房 IP 被拦」，是纯地域规则；住宅 vs 机房无关。
# 另测 5 种 UA × 4 种 X-Real-IP = 20 组，全部命中同一个 12KB 挑战页：UA/X-Real-IP 不是判定维度，
# 伪造这两个头在原理上就不可能生效（LDXP_UA / LDXP_X_REAL_IP 仅作预案保留，默认留空）。
# 结论：服务器（海外）走主代理池时 ldxp 恒定被拦，必须给 ldxp 单独一个中国出口。
# 配了下面任一项，ldxp 的探针/抓取就改走该池；未配置则沿用主池（现状：被拦）。
#   LDXP_PROXY_LIST     静态国内代理，逗号分隔，支持 http://user:pass@host:port
#   LDXP_PROXY_POOL_URL 短效代理提取接口（每次调用返回 ip:port 列表，也兼容 `ip:port,剩余秒数`）
#   LDXP_PROXY_TTL_S    重取间隔秒数，必须小于 IP 有效期（巨量IP 短效默认 1 小时 → 默认 3000s）
LDXP_PROXY_LIST=
LDXP_PROXY_POOL_URL=
LDXP_PROXY_TTL_S=3000
LDXP_UA=
LDXP_X_REAL_IP=
