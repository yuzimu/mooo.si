# MongoDB（1Panel 应用商店安装，仅监听 127.0.0.1，开启认证，库 mooo + 专用用户）
# 容器内访问宿主机 127.0.0.1 需 network_mode: host 或 host.docker.internal
MONGO_URL=mongodb://mooo:CHANGE_ME@127.0.0.1:27017/mooo?authSource=mooo
MONGO_DB=mooo
RAW_RETENTION_DAYS=14
CRAWL_INTERVAL_MIN=30
ENABLE_SCHEDULER=1
PROXY_POOL_URL=
PROXY_LIST=
BROWSER_CDP_URL=
# 管线（每 2 小时一轮）
PROXY_REQUIRED=1             # 生产必须为 1：代理池不可用则整轮停止，不直连
CRAWL_EVERY_HOURS=24
TARGET_WORKERS=4             # 全局并发上限（同域名始终串行）
DOMAIN_DELAY=2.0             # 同域名请求间隔（秒）
TARGET_CRAWL_MAX=120         # 每轮最多定向抓取目标数
TARGET_MIN_INTERVAL_H=6      # 同一目标最小抓取间隔
MAX_PAGES_PER_TARGET=5
TG_DB_PATH=/tg/messages.db
TG_PREVIEW_MAX=40
GITHUB_LIST_URLS=https://raw.githubusercontent.com/LiLittleCat/awesome-free-chatgpt/main/README.md
BRAVE_API_KEY=               # 搜索引擎指纹发现（可选）
# 链动小铺 ShopApi 请求头覆盖（留空=用项目 UA，实测即可正常采集）
# 实测：ESA 的 http_bot_simple 规则只拦 httpx 库默认 UA（x-tengine-error: denied by http_bot_simple）；
# 项目 UA / Baiduspider / 浏览器 UA 均可放行，X-Real-IP 对放行与否无影响。
# 如需固定成 Baiduspider 再打开下面两行：
LDXP_UA=
LDXP_X_REAL_IP=
