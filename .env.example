# MongoDB（1Panel 应用商店安装，仅监听 127.0.0.1，开启认证，库 mooo + 专用用户）
# 容器内访问宿主机 127.0.0.1 需 network_mode: host 或 host.docker.internal
MONGO_URL=mongodb://mooo:CHANGE_ME@127.0.0.1:27017/mooo?authSource=mooo
MONGO_DB=mooo
RAW_RETENTION_DAYS=14
CRAWL_INTERVAL_MIN=30
ENABLE_SCHEDULER=1
PROXY_POOL_URL=
PROXY_LIST=
BROWSER_CDP_URL=
# 管线（每 2 小时一轮）
PROXY_REQUIRED=1             # 生产必须为 1：代理池不可用则整轮停止，不直连
CRAWL_EVERY_HOURS=24
TARGET_WORKERS=4             # 全局并发上限（同域名始终串行）
DOMAIN_DELAY=2.0             # 同域名请求间隔（秒）
TARGET_CRAWL_MAX=120         # 每轮最多定向抓取目标数
TARGET_MIN_INTERVAL_H=6      # 同一目标最小抓取间隔
MAX_PAGES_PER_TARGET=5
TG_DB_PATH=/tg/messages.db
TG_PREVIEW_MAX=40
GITHUB_LIST_URLS=https://raw.githubusercontent.com/LiLittleCat/awesome-free-chatgpt/main/README.md
BRAVE_API_KEY=               # 搜索引擎指纹发现（可选）
CAPTCHA_RETRY_H=168          # blocked_captcha 目标冷处理时长（小时，默认 7 天）
# 链动小铺 ShopApi 请求头覆盖（通常留空）
# 实测结论（2026-10-13，服务器容器内）：ldxp 全站套阿里云 ESA 的 AliyunCaptcha JS 挑战，
# 从服务器出口（代理池 IP 与服务器直连 IP 都一样）对 4 个域名全部返回 200 + 12KB 挑战页
# （x-tengine-error: denied by http_custom / http_security_level，set-cookie: acw_tc）。
# 试过 5 种 UA × 4 种 X-Real-IP = 20 组组合，无一放行 —— UA/X-Real-IP 不是判定维度，
# 换 UA 或伪造 X-Real-IP 都无效。住宅 IP 直连可过，服务器出口过不去。
# 因此 ldxp 店铺直采在服务器上不可用，ldxp 报价改由 ldxp-showcase（kawanghub 公开 JSON）覆盖。
# 下面两个变量仅作预案保留：若 ESA 规则放开，可用 LDXP_UA / LDXP_X_REAL_IP 固定请求头。
LDXP_UA=
LDXP_X_REAL_IP=
